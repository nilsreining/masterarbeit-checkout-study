# ---------------------------------------------------------------------------
# Environment Variables – Vorlage
#
# Kopieren nach .env.local und anpassen:  cp .env.example .env.local
# .env.local wird NICHT committet. Niemals Secrets in dieses Repository legen.
#
# Hinweis: Variablen mit Präfix NEXT_PUBLIC_ werden beim Build in den
# Browser-Code eingebettet und sind öffentlich sichtbar. Dort dürfen nur
# unkritische Werte (z. B. URLs) stehen – niemals Schlüssel oder Passwörter.
# ---------------------------------------------------------------------------

# --- INTEGRATION POINT C: Abschließende Befragung (Google Form 2) -----------
# Leer lassen → lokale Platzhalterseite /survey-placeholder.
#
# Variante 1: Google-Forms-„vorausgefüllter Link“ mit Platzhalter {token}
#   NEXT_PUBLIC_POST_SURVEY_URL=https://docs.google.com/forms/d/e/<FORM_ID>/viewform?usp=pp_url&entry.<FELD_ID>={token}
#
# Variante 2: beliebige URL; der Token wird als Query-Parameter angehängt
#   NEXT_PUBLIC_POST_SURVEY_URL=https://example.org/umfrage
#   → https://example.org/umfrage?participant_token=<TOKEN>
NEXT_PUBLIC_POST_SURVEY_URL=

# Name des Query-Parameters für Variante 2 (Default: participant_token)
NEXT_PUBLIC_POST_SURVEY_TOKEN_PARAM=participant_token

# --- Später (aktuell NICHT verwendet) – nur als Orientierung ----------------
# INTEGRATION POINT A/B: Basis-URL eines eigenen Studien-Backends, das
# Teilnehmerdaten liefert und Events/Entscheidungen entgegennimmt.
# NEXT_PUBLIC_STUDY_API_BASE_URL=https://api.example.org/study
#
# Nur serverseitig (Backend), niemals mit NEXT_PUBLIC_-Präfix:
# DATABASE_URL=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=
