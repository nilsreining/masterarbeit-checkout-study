# ---------------------------------------------------------------------------
# Environment Variables – Vorlage
#
# Kopieren nach .env.local und anpassen:  cp .env.example .env.local
# .env.local wird NICHT committet. Niemals Secrets in dieses Repository legen.
#
# Hinweis: Variablen mit Präfix NEXT_PUBLIC_ werden beim Build in den
# Browser-Code eingebettet und sind öffentlich sichtbar. Dort dürfen nur
# unkritische Werte (z. B. URLs) stehen – niemals Schlüssel oder Passwörter.
# ---------------------------------------------------------------------------

# --- INTEGRATION POINT A: Teilnehmerdaten (Google Apps Script Web-App) -------
# Leer lassen → Standard-URL aus src/lib/studyConfig.ts.
# Abgefragt wird: GET <URL>?token=<TOKEN>
NEXT_PUBLIC_STUDY_API_URL=

# Quelle der Teilnehmerdaten: apps-script (Standard) oder mock (lokale Demo-Tokens
# GENERIC_DEMO, PERSONALIZED_DEMO, COMPLETED_DEMO – ohne Netzwerk).
NEXT_PUBLIC_PARTICIPANT_SOURCE=apps-script

# --- INTEGRATION POINT C: Abschließende Befragung (Google Form 2) -----------
# Leer lassen → Google Form 2 aus src/lib/studyConfig.ts.
# Aufgerufen wird: <URL>?usp=pp_url&<TOKEN_PARAM>=<TOKEN> (vorausgefüllte Studien-ID).
#   Anderes Formular: NEXT_PUBLIC_POST_SURVEY_URL=https://docs.google.com/forms/d/e/<FORM_ID>/viewform
#   Lokaler Platzhalter ohne Google:  NEXT_PUBLIC_POST_SURVEY_URL=/survey-placeholder
NEXT_PUBLIC_POST_SURVEY_URL=

# Entry-ID der Frage „Studien-ID“ (Standard: entry.1548559708).
# Für /survey-placeholder: participant_token
NEXT_PUBLIC_POST_SURVEY_TOKEN_PARAM=

# --- Später (aktuell NICHT verwendet) – nur als Orientierung ----------------
# Nur serverseitig (Backend), niemals mit NEXT_PUBLIC_-Präfix:
# DATABASE_URL=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=
